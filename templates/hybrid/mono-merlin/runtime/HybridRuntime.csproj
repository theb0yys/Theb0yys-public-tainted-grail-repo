<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TGCommunity.HybridRuntime</AssemblyName>
    <RootNamespace>TGCommunity.HybridRuntime</RootNamespace>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Games\Tainted Grail FoA</GameRoot>
    <BepInExCore>$(GameRoot)\BepInEx\core</BepInExCore>
    <ManagedDir>$(GameRoot)\Fall of Avalon_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
