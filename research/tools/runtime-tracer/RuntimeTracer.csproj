<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>TGCommunity.RuntimeTracer</AssemblyName>
    <RootNamespace>TGCommunity.RuntimeTracer</RootNamespace>
    <FoAGameRoot Condition="'$(FoAGameRoot)' == ''">$(TAINTED_GRAIL_FOA_ROOT)</FoAGameRoot>
    <BepInExCoreDir>$(FoAGameRoot)\BepInEx\core</BepInExCoreDir>
    <ManagedDir>$(FoAGameRoot)\Fall of Avalon_Data\Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Plugin.cs" />
    <Compile Include="RuntimeTracerCore.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FoAGameRoot)' == ''" Text="Supply FoAGameRoot or TAINTED_GRAIL_FOA_ROOT for your local Mono/BepInEx 5 installation." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found under the supplied FoAGameRoot." />
    <Error Condition="!Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="0Harmony.dll was not found under the supplied FoAGameRoot." />
    <Error Condition="!Exists('$(ManagedDir)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found under the supplied FoAGameRoot." />
  </Target>
</Project>
