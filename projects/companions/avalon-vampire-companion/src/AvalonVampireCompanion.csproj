<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>AvalonVampireCompanion</AssemblyName>
    <RootNamespace>AvalonVampireCompanion</RootNamespace>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <FoAGameRoot Condition="'$(FoAGameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Tainted Grail FoA</FoAGameRoot>
    <FoAManagedDir>$(FoAGameRoot)\Fall of Avalon_Data\Managed</FoAManagedDir>
    <BepInExCoreDir>$(FoAGameRoot)\BepInEx\core</BepInExCoreDir>
    <FoAPluginsDir>$(FoAGameRoot)\BepInEx\plugins</FoAPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(FoAManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(FoAManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(FoAManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(FoAManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(FoAManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Addressables"><HintPath>$(FoAManagedDir)\Unity.Addressables.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.ResourceManager"><HintPath>$(FoAManagedDir)\Unity.ResourceManager.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TG.Main"><HintPath>$(FoAManagedDir)\TG.Main.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Awaken.Utility"><HintPath>$(FoAManagedDir)\Awaken.Utility.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Awaken.PackageUtilities"><HintPath>$(FoAManagedDir)\Awaken.PackageUtilities.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\avalon-creature-companion-shared-source\StandaloneCreatureCompanionPlugin.cs" Link="StandaloneCreatureCompanionPlugin.cs" />
    <EmbeddedResource Include="Icons\*.png" LogicalName="AvalonVampireCompanion.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ValidateFoAReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found at '$(BepInExCoreDir)\BepInEx.dll'. Build with -p:FoAGameRoot=&quot;path\to\Tainted Grail FoA&quot;." />
    <Error Condition="!Exists('$(FoAManagedDir)\TG.Main.dll')" Text="TG.Main.dll was not found at '$(FoAManagedDir)\TG.Main.dll'. Build with -p:FoAGameRoot=&quot;path\to\Tainted Grail FoA&quot;." />
  </Target>

  <Target Name="DeployToFoA" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <MakeDir Directories="$(FoAPluginsDir)\$(AssemblyName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FoAPluginsDir)\$(AssemblyName)" />
  </Target>
</Project>
