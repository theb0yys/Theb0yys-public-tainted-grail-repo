<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TGCommunity.Il2CppFirstGameChange</AssemblyName>
    <RootNamespace>TGCommunity.Il2CppFirstGameChange</RootNamespace>
    <GameRoot Condition="'$(GameRoot)' == ''">C:\Games\Tainted Grail FoA</GameRoot>
    <BepInExCore>$(GameRoot)\BepInEx\core</BepInExCore>
    <UnityLibs>$(GameRoot)\BepInEx\unity-libs</UnityLibs>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core">
      <HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.Common">
      <HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Unity.IL2CPP">
      <HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityLibs)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityLibs)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateFoAReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCore)\BepInEx.Unity.IL2CPP.dll')" Text="BepInEx.Unity.IL2CPP.dll was not found under '$(BepInExCore)'. Use the IL2CPP Tainted Grail installation you are actually targeting." />
    <Error Condition="!Exists('$(UnityLibs)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll was not found under '$(UnityLibs)'. Run the matching BepInEx 6 IL2CPP setup first and check the installed Unity libraries." />
  </Target>
</Project>
