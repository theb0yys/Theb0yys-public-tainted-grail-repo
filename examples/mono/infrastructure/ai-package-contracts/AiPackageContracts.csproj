<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>TGCommunity.AiPackageContracts</AssemblyName>
    <RootNamespace>TGCommunity.AiPackageContracts</RootNamespace>
    <AvalonAiContractsDir Condition="'$(AvalonAiContractsDir)' == ''">C:\Path\To\AvalonAI</AvalonAiContractsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AvalonAI.Contracts.V2">
      <HintPath>$(AvalonAiContractsDir)\AvalonAI.Contracts.V2.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateInfrastructureReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AvalonAiContractsDir)\AvalonAI.Contracts.V2.dll')" Text="AvalonAI.Contracts.V2.dll not found. Set AvalonAiContractsDir." />
  </Target>
</Project>
