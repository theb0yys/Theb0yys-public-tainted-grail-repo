<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TGCommunity.SharedUiIntegration</AssemblyName>
    <RootNamespace>TGCommunity.SharedUiIntegration</RootNamespace>
    <FoAGameRoot Condition="'$(FoAGameRoot)' == ''">C:\Games\Tainted Grail FoA</FoAGameRoot>
    <FoAManagedDir>$(FoAGameRoot)\Fall of Avalon_Data\Managed</FoAManagedDir>
    <BepInExCoreDir>$(FoAGameRoot)\BepInEx\core</BepInExCoreDir>
    <FoAPluginsDir>$(FoAGameRoot)\BepInEx\plugins</FoAPluginsDir>
    <FoAModManagerDir Condition="'$(FoAModManagerDir)' == ''">$(FoAPluginsDir)\FoAModManager</FoAModManagerDir>
    <TaintedInterfaceDir Condition="'$(TaintedInterfaceDir)' == ''">$(FoAPluginsDir)\TaintedInterface</TaintedInterfaceDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(FoAManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(FoAManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(FoAManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(FoAManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FoAModManager">
      <HintPath>$(FoAModManagerDir)\FoAModManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TaintedInterface">
      <HintPath>$(TaintedInterfaceDir)\TaintedInterface.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="ValidateInfrastructureReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(FoAModManagerDir)\FoAModManager.dll')" Text="FoAModManager.dll not found. Set FoAModManagerDir." />
    <Error Condition="!Exists('$(TaintedInterfaceDir)\TaintedInterface.dll')" Text="TaintedInterface.dll not found. Set TaintedInterfaceDir." />
  </Target>
</Project>
