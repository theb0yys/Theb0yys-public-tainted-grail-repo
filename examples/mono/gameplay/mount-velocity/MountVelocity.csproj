<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>TGCommunity.Example.MountVelocity</AssemblyName>
    <RootNamespace>TGCommunity.Example.MountVelocity</RootNamespace>
    <FoAGameRoot Condition="'$(FoAGameRoot)' == ''">C:\Path\To\Tainted Grail FoA</FoAGameRoot>
    <BepInExCoreDir>$(FoAGameRoot)\BepInEx\core</BepInExCoreDir>
    <ManagedDir>$(FoAGameRoot)\Fall of Avalon_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TG.Main"><HintPath>$(ManagedDir)\TG.Main.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateLocalReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx.dll was not found. Supply a Mono/BepInEx 5 FoAGameRoot." />
    <Error Condition="!Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="0Harmony.dll was not found." />
    <Error Condition="!Exists('$(ManagedDir)\TG.Main.dll')" Text="TG.Main.dll was not found." />
  </Target>
</Project>
