<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AvalonExceptions</AssemblyName>
    <RootNamespace>AvalonExceptions</RootNamespace>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <FoAGameRoot Condition="'$(FoAGameRoot)' == ''"></FoAGameRoot>
    <BepInExCoreDir>$(FoAGameRoot)\BepInEx\core</BepInExCoreDir>
    <FoAInteropDir>$(FoAGameRoot)\BepInEx\interop</FoAInteropDir>
    <FoAPluginsDir>$(FoAGameRoot)\BepInEx\plugins</FoAPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="CompilerServicesShims.cs" />
    <Compile Include="Il2CppPlugin.cs" />
    <Compile Include="..\src\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\tainted-framework\src\Tainted.Abstractions\Tainted.Abstractions.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCoreDir)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCoreDir)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCoreDir)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(FoAInteropDir)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(BepInExCoreDir)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(FoAInteropDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(FoAInteropDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(FoAInteropDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(FoAInteropDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="ValidateFoAIl2CppReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(FoAGameRoot)' == ''" Text="FoAGameRoot is required for The Last Menhir IL2CPP." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(BepInExCoreDir)\BepInEx.Core.dll')" Text="BepInEx.Core.dll was not found at '$(BepInExCoreDir)\BepInEx.Core.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll')" Text="BepInEx.Unity.IL2CPP.dll was not found at '$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(BepInExCoreDir)\Il2CppInterop.Runtime.dll')" Text="Il2CppInterop.Runtime.dll was not found at '$(BepInExCoreDir)\Il2CppInterop.Runtime.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(BepInExCoreDir)\0Harmony.dll')" Text="0Harmony.dll was not found at '$(BepInExCoreDir)\0Harmony.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(FoAInteropDir)\Il2Cppmscorlib.dll')" Text="Generated interop Il2Cppmscorlib.dll was not found at '$(FoAInteropDir)\Il2Cppmscorlib.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(BepInExCoreDir)\SemanticVersioning.dll')" Text="SemanticVersioning.dll was not found at '$(BepInExCoreDir)\SemanticVersioning.dll'." />
    <Error Condition="'$(FoAGameRoot)' != '' and !Exists('$(FoAInteropDir)\UnityEngine.CoreModule.dll')" Text="Generated interop UnityEngine.CoreModule.dll was not found at '$(FoAInteropDir)\UnityEngine.CoreModule.dll'." />
  </Target>

  <Target Name="DeployToFoA" AfterTargets="Build" Condition="'$(DeployOnBuild)' == 'true'">
    <MakeDir Directories="$(FoAPluginsDir)\AvalonExceptions" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(FoAPluginsDir)\AvalonExceptions" />
    <Copy SourceFiles="..\README.md" DestinationFiles="$(FoAPluginsDir)\AvalonExceptions\README.md" Condition="Exists('..\README.md')" />
    <Copy SourceFiles="..\release\changelog.md" DestinationFiles="$(FoAPluginsDir)\AvalonExceptions\CHANGELOG.md" Condition="Exists('..\release\changelog.md')" />
    <Copy SourceFiles="..\release\manifest.md" DestinationFiles="$(FoAPluginsDir)\AvalonExceptions\MANIFEST.md" Condition="Exists('..\release\manifest.md')" />
  </Target>
</Project>
